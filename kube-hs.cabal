cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'kube-hs' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               kube-hs

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            GPL-3.0-or-later

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Horobets Ihor

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         ihor@horobets.dev

-- A copyright notice.
-- copyright:
category:           Development
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:             warnings
    exposed-modules:    Kubernetes.Client
                       , Kubernetes.Resource
                       , Kubernetes.Operator
                       , Kubernetes.Operator.Types
                       , Kubernetes.Operator.Cache
                       , Kubernetes.Operator.Workqueue
                       , Kubernetes.Operator.Client
                       , Kubernetes.Operator.Reflector
                       , Kubernetes.Operator.Controller
                       , Kubernetes.Operator.Manager
                       , Kubernetes.Operator.Metrics
                       , Kubernetes.Operator.Finalizer
                       , Kubernetes.Codegen.Schema
                       , Kubernetes.Codegen.Generate
    other-modules:      Kubernetes.Operator.Internal.Async
    hs-source-dirs:     src
    default-language:   GHC2024
    default-extensions: OverloadedStrings
                       , TypeFamilies
    build-depends:
        base             ^>=4.20.2.0
      , effectful        >=2.3 && <2.6
      , aeson            >=2.0
      , bytestring
      , text
      , time
      , stm
      , async
      , containers
      , unix
      , http-client      >=0.7
      , http-client-tls
      , connection
      , tls
      , x509-store
      , http-types
      , directory

executable kube-hs
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- LANGUAGE extensions used by modules in this package.
    default-extensions: OverloadedStrings

    -- Other library packages from which modules are imported.
    build-depends:
        base             ^>=4.20.2.0
      , kube-hs
      , effectful

    -- Directories containing source files.
    hs-source-dirs:   exe

    -- Base language which the package is written in.
    default-language: GHC2024

executable configmap-logger
    import:              warnings
    main-is:             ConfigMapLogger.hs
    hs-source-dirs:      examples
    default-language:    GHC2024
    default-extensions:  OverloadedStrings
    build-depends:
        base             ^>=4.20.2.0
      , kube-hs
      , effectful
      , aeson
      , containers
      , text

executable website-operator
    import:              warnings
    main-is:             WebsiteOperator.hs
    other-modules:       Website
    hs-source-dirs:      examples, examples/generated
    default-language:    GHC2024
    default-extensions:  OverloadedStrings
    build-depends:
        base             ^>=4.20.2.0
      , kube-hs
      , effectful
      , aeson
      , containers
      , text

executable crd-codegen
    import:              warnings
    main-is:             Main.hs
    hs-source-dirs:      codegen
    default-language:    GHC2024
    default-extensions:  OverloadedStrings
    build-depends:
        base             ^>=4.20.2.0
      , kube-hs
      , aeson
      , yaml
      , bytestring
      , text

test-suite kube-hs-test
    import:              warnings
    type:                exitcode-stdio-1.0
    main-is:             Spec.hs
    hs-source-dirs:      test
    default-language:    GHC2024
    default-extensions:  OverloadedStrings
    ghc-options:         -threaded
    build-depends:
        base             ^>=4.20.2.0
      , kube-hs
      , effectful
      , aeson
      , bytestring
      , stm
      , async
      , text
      , http-types
      , wai
      , warp
